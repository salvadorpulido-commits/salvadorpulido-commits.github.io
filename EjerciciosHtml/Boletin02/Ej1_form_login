<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Formulario de Autenticación Básico</title>

</head>

<body>

    <form action="https://lm.ciclo.iesnervion.es/login.php" method="POST">

        <fieldset>
            <label for="usuario">Nombre de usuario o Email:</label>
            <input name="usuario" id="usuario" type="text" placeholder="usuario@dominio.com" required>
            <br>
            <label for="password">Contraseña:</label>
            <input name="password" id="password" type="password" placeholder="Introduce la contraseña:" required>
            <br>
            <p>
                <label for="recordar">Recordar Sesión</label>
                <input type="checkbox" id="recordar" name="recordar">

            </p>
            <br>
            <button type="submit">Iniciar Sesión</button>


        </fieldset>

    </form>


</body>



</html>